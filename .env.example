# Entorno
ADVISOR_ENV=dev
ADVISOR_BROKER=alpaca
ADVISOR_BASE_CURRENCY=USD
ADVISOR_UNIVERSE_PATH=configs/universe_alpaca_us.json

# Riesgo por defecto
ADVISOR_RISK_PER_TRADE=0.0075
ADVISOR_MAX_POSITION_PCT=0.12
ADVISOR_MAX_DAILY_LOSS_PCT=0.02
ADVISOR_MAX_POSITION_LOSS_PCT=0.025  # vende ESA acción si cae −2.5%
ADVISOR_KILL_SWITCH_MODE=rotate      # rotate=cierra perdedoras y busca otras | pause=bloquea
ADVISOR_HALT_CLOSE_LOSERS=true
ADVISOR_HALT_FLATTEN_ALL=false
ADVISOR_DEFENSE_RISK_MULT=0.45
ADVISOR_MIN_EDGE_NET_PCT=0.0003      # acepta ganancias chicas tras costos
ADVISOR_ALLOW_MICRO_EDGE=true
ADVISOR_TOP_N=30
ADVISOR_MAX_POSITIONS=8
# Universo amplio USA (Alpaca)
# ADVISOR_UNIVERSE_PATH=configs/universe_alpaca_us.json

# Costos Alpaca (commission-free equities + slippage)
ADVISOR_COMMISSION_RATE=0.0
ADVISOR_VAT_RATE=0.0
ADVISOR_SLIPPAGE_BPS=5

# Datos / horizonte
ADVISOR_LOOKBACK_DAYS=420
ADVISOR_HORIZON_DAYS=10

# Persistencia local
ADVISOR_DATA_DIR=data

# Alpaca API (paper primero)
ADVISOR_ALPACA_API_KEY=
ADVISOR_ALPACA_SECRET_KEY=
ADVISOR_ALPACA_PAPER=true

# Live BTG (mantener false hasta tener API/DMA oficial)
ADVISOR_BTG_LIVE_ENABLED=false
ADVISOR_BTG_ACCOUNT_ID=
ADVISOR_BTG_LIVE_TOKEN=

# Noticias mundiales (RSS + Yahoo; NewsAPI opcional)
ADVISOR_NEWS_ENABLED=true
ADVISOR_NEWS_WEIGHT=0.22
ADVISOR_NEWS_LOOKBACK_DAYS=14
ADVISOR_NEWS_SEMANTIC_WEIGHT=0.55
ADVISOR_NEWS_CACHE_TTL_SEC=900
ADVISOR_NEWSAPI_KEY=

# Earnings blackout
ADVISOR_EARNINGS_ENABLED=true
ADVISOR_EARNINGS_BLACKOUT_BEFORE=2
ADVISOR_EARNINGS_BLACKOUT_AFTER=1

# Capa IA de decisión (encima del cuant; gate del autopilot)
ADVISOR_AI_ENABLED=true
ADVISOR_AI_PROVIDER=local          # local | openai | anthropic
ADVISOR_AI_API_KEY=
ADVISOR_AI_MODEL=                  # vacío = default del provider
ADVISOR_AI_BASE_URL=https://api.openai.com/v1
ADVISOR_AI_GATE_AUTOPILOT=true     # solo compra si IA approve_trade=true

# Tiempo real (dashboard)
ADVISOR_LIVE_ENABLED=true
ADVISOR_LIVE_POLL_SEC=8            # precios / equity / posiciones
ADVISOR_LIVE_ANALYZE_SEC=120       # re-análisis cuant + IA

# Entorno
ADVISOR_ENV=dev
ADVISOR_BASE_CURRENCY=CLP

# Riesgo por defecto
ADVISOR_RISK_PER_TRADE=0.0075
ADVISOR_MAX_POSITION_PCT=0.12
ADVISOR_MAX_DAILY_LOSS_PCT=0.02
ADVISOR_MIN_EDGE_NET_PCT=0.004

# Costos estimados BTG Chile (acciones digitales)
# Comisión hasta ~0.4% + IVA por lado; usamos estimado conservador round-trip
ADVISOR_COMMISSION_RATE=0.004
ADVISOR_VAT_RATE=0.19
ADVISOR_SLIPPAGE_BPS=8

# Datos
ADVISOR_LOOKBACK_DAYS=420
ADVISOR_HORIZON_DAYS=10
ADVISOR_TOP_N=8

# Persistencia local
ADVISOR_DATA_DIR=data
